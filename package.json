{
  "name": "ben-fit",
  "version": "1.1.0",
  "private": true,
  "engines": {
    "node": ">=18.18.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --ext .js,.jsx --max-warnings=0",
    "lint:fix": "eslint . --ext .js,.jsx --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "jest",
    "test:watch": "jest --watch",
    "typecheck": "tsc --noEmit -p jsconfig.json",
    "verify": "npm run lint && npm run format:check && npm test"
  },
  "dependencies": {
    "@supabase/ssr": "^0.5.2",
    "@supabase/supabase-js": "^2.43.1",
    "next": "^15.5.29",
    "react": "^18",
    "react-dom": "^18",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.4.6",
    "@testing-library/react": "^15.0.7",
    "autoprefixer": "^10.0.1",
    "eslint": "^8.57.0",
    "eslint-config-next": "^15.5.29",
    "eslint-config-prettier": "^9.1.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "postcss": "^8.5.23",
    "prettier": "^3.3.3",
    "tailwindcss": "^3.3.0",
    "typescript": "^5.5.4"
  },
  "overrides": {
    "postcss": "$postcss"
  }
}
